# Copy to .env and fill in
NODE_ENV=development
PORT=9100

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smiraclub

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Who the admin panel is allowed to call from (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# The first account the seed creates. Leave the password blank and the seed
# generates one and prints it once — which is safer than a value that lives in
# a file everybody can read.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=

# With no SMS provider wired, the one-time code comes back in the API response
# so the panel can be signed into at all. That is an authentication bypass —
# anyone who can reach the API can sign in as anyone. Set it to false the
# moment real customer data is in the database, and wire a provider in
# src/helpers/sms.js.
SMS_DEMO_CODES=true
