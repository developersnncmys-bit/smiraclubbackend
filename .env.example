# Copy to .env and fill in
NODE_ENV=development
PORT=9100

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smiraclub

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Who the admin panel is allowed to call from (comma separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# The first account the seed creates. Leave the password blank and the seed
# generates one and prints it once — which is safer than a value that lives in
# a file everybody can read.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_PASSWORD=

# With no SMS provider wired, the one-time code comes back in the API response
# so the panel can be signed into at all. That is an authentication bypass —
# anyone who can reach the API can sign in as anyone. Set it to false the
# moment real customer data is in the database, and wire a provider in
# src/helpers/sms.js.
SMS_DEMO_CODES=true

# -- SMS, for the one-time codes -------------------------------------------
# Nimbus IT (nimbusit.biz). Fill these in and the bypass above turns itself
# off: the code is texted and never appears in an API response again.
#
# UserID and Password are the gateway account, not the panel login. SenderID
# is the approved six-letter header. EntityID and TemplateID come from the
# DLT registration, and SMS_TEMPLATE must match the registered wording word
# for word — {code} is the only part that varies, or the operator drops it.
SMS_API_URL=https://www.nimbusit.biz/api/SmsApi/SendSingleApi
SMS_USER_ID=
SMS_PASSWORD=
SMS_SENDER_ID=
SMS_ENTITY_ID=
SMS_TEMPLATE_ID=
SMS_TEMPLATE={code} is your Smira Club verification code. Do not share it with anyone.
